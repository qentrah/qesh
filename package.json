{
  "name": "qesh",
  "version": "0.6.3",
  "type": "module",
  "bin": {
    "qesh": "./bin/qesh",
    "qentrah-terminal": "./bin/qentrah-terminal",
    "q-terminal": "./bin/q-terminal",
    "qh": "./bin/qh"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "test": "bun test",
    "check": "tsc --noEmit",
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "build:app": "node scripts/build-macos-app.mjs",
    "desktop": "bun run build:desktop && electron desktop/main.cjs",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.6.1",
    "@opentui/react": "0.6.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "electron": "44.7.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.5",
    "node": ">=22.13"
  },
  "trustedDependencies": [
    "electron"
  ],
  "description": "Qentrah’s open-source macOS shell workspace with tabs, groups, and resizable split panes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qentrah/qesh.git"
  },
  "homepage": "https://qentrah.com/qesh",
  "bugs": {
    "url": "https://github.com/qentrah/qesh/issues"
  }
}
